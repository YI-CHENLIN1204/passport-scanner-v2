@PassportScanner_Api_HostAddress = http://localhost:5080

GET {{PassportScanner_Api_HostAddress}}/api/health
Accept: application/json

###

# Pure validation: does not save.
POST {{PassportScanner_Api_HostAddress}}/api/passport-reviews/validate
Content-Type: application/json

{
  "schemaVersion": 2,
  "documentType": "passport",
  "chineseName": "測試旅客",
  "englishName": "TEST, TRAVELER",
  "passportNumber": "T12345678",
  "nationality": "TWN",
  "issuingState": "TWN",
  "birthDate": "2000-01-15",
  "sex": "M",
  "expiryDate": "2030-12-31",
  "verification": {
    "passportNumberCheckDigit": true,
    "birthDateCheckDigit": true,
    "expiryDateCheckDigit": true,
    "compositeCheckDigit": true
  },
  "reviewAssertions": {
    "chineseNameVisuallyConfirmed": true,
    "englishNameVisuallyConfirmed": true
  },
  "ocr": {
    "engine": "paddleocr-ppocrv5",
    "line2Validated": true,
    "chineseNameSource": "name-field",
    "chineseNameScore": 0.93,
    "chineseNameRomanizationStatus": "compatible",
    "fallbackUsed": false,
    "averageScore": 0.91
  },
  "reviewedAt": "2026-10-01T00:00:00+00:00"
}

