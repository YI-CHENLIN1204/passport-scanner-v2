# Development can leave this empty and use the Vite /api proxy.
# For a separately deployed frontend, set the public API origin, for example:
# VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=


# PaddleOCR model asset base URL.
# In local Vite development, /paddle-models is proxied to the official Paddle model CDN
# to avoid third-party CORS issues.
VITE_PADDLE_MODEL_BASE_URL=/paddle-models
